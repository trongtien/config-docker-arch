FROM archlinux:latest

# Install setting and package for Arch Linux
#   tree-sitter-cli + base-devel: nvim-treesitter (branch main) build parser bang CLI nay
#   clang: clangd (LSP) + clang-format (conform)
#   go: gopls can go toolchain, gofmt di kem
#   elixir: formatter "mix" trong conform
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
    git \
    tmux \
    base-devel \
    curl \
    wget \
    fzf \
    ripgrep \
    fd \
    unzip \
    nodejs \
    npm \
    tree-sitter-cli \
    clang \
    rust-analyzer \
    go \
    gopls \
    typescript \
    typescript-language-server \
    yaml-language-server \
    bash-language-server \
    dockerfile-language-server \
    stylua \
    ruff \
    elixir

# Cac LSP server khong co trong repo Arch:
#   vscode-langservers-extracted -> vscode-json-language-server (jsonls)
#                                   vscode-html-language-server (html)
#   basedpyright                 -> basedpyright-langserver
#   @angular/language-server     -> ngserver (angularls)
RUN npm install -g \
    vscode-langservers-extracted \
    basedpyright \
    awk-language-server \
    @angular/language-server \
    prettier

# Install latest neovim from github release
RUN curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz && \
    rm -rf /opt/nvim-linux-x86_64 /opt/nvim && \
    tar -C /opt -xzf nvim-linux-x86_64.tar.gz && \
    ln -sf /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim && \
    rm nvim-linux-x86_64.tar.gz

# Create config folder in container with XDG standard
RUN mkdir -p /root/.config/nvim /root/.config/tmux

WORKDIR /projects

# Run tmux with config file folder tmux
CMD ["tmux", "-f", "/root/.config/tmux/tmux.conf"]
